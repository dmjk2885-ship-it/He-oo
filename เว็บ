<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GK HUB - Roblox Script Official</title>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #0b0f19;
            --card-bg: rgba(18, 26, 43, 0.75);
            --border-color: rgba(0, 210, 255, 0.2);
            --primary-blue: #0072ff;
            --cyan-accent: #00d2ff;
            --discord-color: #5865F2;
            --text-main: #ffffff;
            --text-sub: #94a3b8;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Kanit', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(0, 114, 255, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(0, 210, 255, 0.15) 0%, transparent 40%);
            background-attachment: fixed;
        }

        .container {
            width: 100%;
            max-width: 650px;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            backdrop-filter: blur(12px);
            border-radius: 24px;
            padding: 35px 25px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5),
                        0 0 20px rgba(0, 210, 255, 0.1);
            text-align: center;
        }

        .logo-box {
            margin-bottom: 15px;
            display: inline-block;
        }

        .logo-box i {
            font-size: 55px;
            background: linear-gradient(135deg, var(--cyan-accent), var(--primary-blue));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 0 10px rgba(0, 210, 255, 0.4));
        }

        h1 {
            font-size: 32px;
            font-weight: 700;
            letter-spacing: 1px;
            background: linear-gradient(135deg, #ffffff, var(--cyan-accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 5px;
        }

        .subtitle {
            color: var(--text-sub);
            font-size: 15px;
            margin-bottom: 30px;
            font-weight: 300;
        }

        .script-section {
            background: rgba(8, 12, 22, 0.8);
            border: 1px solid rgba(0, 210, 255, 0.15);
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 25px;
            text-align: left;
        }

        .script-header {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--cyan-accent);
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 12px;
        }

        .code-box {
            background: #050811;
            border: 1px solid #1e293b;
            border-radius: 10px;
            padding: 12px 15px;
            font-family: 'Courier New', Courier, monospace;
            font-size: 13px;
            color: #38bdf8;
            overflow-x: auto;
            white-space: nowrap;
            margin-bottom: 15px;
        }

        .btn {
            width: 100%;
            padding: 14px 20px;
            border-radius: 12px;
            border: none;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .btn-copy {
            background: linear-gradient(135deg, var(--primary-blue), var(--cyan-accent));
            color: #ffffff;
            box-shadow: 0 4px 15px rgba(0, 114, 255, 0.3);
        }

        .btn-copy:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 210, 255, 0.5);
        }

        .btn-discord {
            background: var(--discord-color);
            color: #ffffff;
            box-shadow: 0 4px 15px rgba(88, 101, 242, 0.3);
        }

        .btn-discord:hover {
            transform: translateY(-2px);
            background: #4752c4;
            box-shadow: 0 6px 20px rgba(88, 101, 242, 0.5);
        }

        .footer {
            margin-top: 25px;
            font-size: 13px;
            color: var(--text-sub);
        }

        /* Notification Toast */
        .toast {
            position: fixed;
            bottom: -60px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 210, 255, 0.9);
            color: #000;
            padding: 10px 24px;
            border-radius: 30px;
            font-weight: 600;
            box-shadow: 0 5px 15px rgba(0, 210, 255, 0.4);
            transition: all 0.4s ease;
            opacity: 0;
            pointer-events: none;
        }

        .toast.show {
            bottom: 30px;
            opacity: 1;
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Logo Header -->
        <div class="logo-box">
            <i class="fa-solid fa-gamepad"></i>
        </div>
        <h1>GK HUB</h1>
        <p class="subtitle">สคริปต์ Roblox คุณภาพสูง รวมการใช้งานง่ายไว้ในที่เดียว</p>

        <!-- Script Box Section -->
        <div class="script-section">
            <div class="script-header">
                <i class="fa-solid fa-code"></i>
                <span>GK HUB ALL Script (Loader)</span>
            </div>
            
            <div class="code-box" id="scriptCode">
loadstring(game:HttpGet("https://raw.githubusercontent.com/dmjk2885-ship-it/Lll/refs/heads/main/GKHUB%20ALL"))()
            </div>

            <button class="btn btn-copy" onclick="copyScript()">
                <i class="fa-regular fa-copy"></i>
                <span>คัดลอกสคริปต์</span>
            </button>
        </div>

        <!-- Discord Button Section -->
        <a href="https://discord.gg/Ugssja4wqQ" target="_blank" class="btn btn-discord">
            <i class="fa-brands fa-discord"></i>
            <span>เข้าร่วม Discord GK HUB</span>
        </a>

        <!-- Footer -->
        <div class="footer">
            <p>© 2026 GK HUB. All rights reserved.</p>
        </div>
    </div>

    <!-- Notification -->
    <div class="toast" id="toast">
        <i class="fa-solid fa-check-circle"></i> คัดลอกสคริปต์เรียบร้อยแล้ว!
    </div>

    <script>
        function copyScript() {
            const scriptText = document.getElementById('scriptCode').innerText.trim();
            
            navigator.clipboard.writeText(scriptText).then(() => {
                showToast();
            }).catch(err => {
                // Fallback for older browsers
                const tempInput = document.createElement('textarea');
                tempInput.value = scriptText;
                document.body.appendChild(tempInput);
                tempInput.select();
                document.execCommand('copy');
                document.body.removeChild(tempInput);
                showToast();
            });
        }

        function showToast() {
            const toast = document.getElementById('toast');
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 2500);
        }
    </script>
</body>
</html>
