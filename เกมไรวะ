        r = q["reward"]
        self.player["gold"] += r.get("gold", 0)
        for k, n in r.get("items", {}).items(): self.add_item(k, n)
        for k, n in r.get("materials", {}).items(): self.add_material(k, n)
        for slot, tier, rar in r.get("gear", []):
