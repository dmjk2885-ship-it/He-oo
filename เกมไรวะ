    def clear_screen(self):
        os.system("cls" if os.name == "nt" else "clear")

    def title_bonus(self, key):
        return TITLE_BONUS.get(self.player["current_title"], {}).get(key, 0)

    @staticmethod
    def gear_stat(item, key):
        if not item:
            return 0
        return int(round(item.get(key, 0) * (1 + 0.1 * item.get("plus", 0))))

    def equip_bonus(self, key):
        return sum(it.get(key, 0) for it in self.player["equipment"].values() if it)

    def max_hp(self):
        base = (calc_max_hp(self.player["level"]) + self.title_bonus("hp") + self.equip_bonus("hp")
                + self.alloc("hp") * STAT_PER["hp"] + self.set_bonus()["hp"])
        return int(base * (1 + self.rune_total("hp_pct") / 100))

    def max_mp(self):
        return calc_max_mp(self.player["level"]) + self.alloc("mp") * STAT_PER["mp"]

    def max_stamina(self):
        base = calc_max_stamina(self.player["level"]) + self.title_bonus("stamina") + self.alloc("sta") * STAT_PER["sta"]
        return int(base * (1 + self.rune_total("sta_pct") / 100))

    def get_total_atk(self):
        sb = self.set_bonus()
        atk = calc_base_atk(self.player["level"]) + self.gear_stat(self.player["equipment"].get("weapon"), "atk") + self.gear_stat(self.player["equipment"].get("accessory"), "atk")
        atk += self.title_bonus("atk") + self.alloc("atk") * STAT_PER["atk"] + sb["atk"]
        atk *= 1 + (self.rune_total("atk_pct") + sb["pct"]) / 100
        if "atk_up" in self.player["buffs"]:
            atk *= 1.25
        if "w2_boost" in self.player["buffs"]:
            atk *= 1.35
        if self.rage:
            atk *= 1.4
        return int(atk)

    def get_total_def(self):
        sb = self.set_bonus()
        total = calc_base_def(self.player["level"]) + self.title_bonus("def") + self.alloc("def") * STAT_PER["def"] + sb["def"]
        for slot in ["head", "armor", "pants", "boots", "accessory"]:
            total += self.gear_stat(self.player["equipment"].get(slot), "def")
        total *= 1 + (self.rune_total("def_pct") + sb["pct"]) / 100
        if "def_up" in self.player["buffs"]:
            total *= 1.25
        if "w2_boost" in self.player["buffs"]:
            total *= 1.35
        return int(total)

    def crit_rate(self):
        rate = (12 + self.player["level"] // 2 + self.title_bonus("crit") + self.equip_bonus("crit")
                + self.alloc("crit") // 2 + self.set_bonus()["crit"] + self.rune_total("crit"))
        if "crit_up" in self.player["buffs"]:
            rate += 15
        return min(75, rate)

    def clamp_stats(self):
        p = self.player
        p["hp"] = max(0, min(p["hp"], self.max_hp()))
        p["mp"] = max(0, min(p["mp"], self.max_mp()))
        p["stamina"] = max(0, min(p["stamina"], self.max_stamina()))

    def full_restore(self):
        self.player["hp"] = self.max_hp()
        self.player["mp"] = self.max_mp()
        self.player["stamina"] = self.max_stamina()

    def world_key(self):
        return self.world_event["key"] if self.world_event else None

    def distance(self):
        return abs(self.current_pos[0]) + abs(self.current_pos[1]) + (1000 if self.world == 2 else 0)

    def zone_index(self):
        return zone_of_dist(self.distance())

    def current_tier(self):
        return self.zone_index() + 1

    def step_cost(self):
        return 3 + self.zone_index()

