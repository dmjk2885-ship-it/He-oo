    def save_game(self, silent=False):
        w1, w2 = self.world_data()
        data = {
            "version": SAVE_VERSION,
            "player": self.player,
            "visited_locations": w1["visited"],
            "current_pos": w1["pos"],
            "dungeon_floor": self.dungeon_floor,
            "dungeon_best": self.dungeon_best,
            "difficulty": self.difficulty,
            "world_event": self.world_event,
            "quests": self.quests,
            "stats": self.stats,
            "ext": self.ext_for_save(w1, w2),
        }
        try:
            if os.path.exists(SAVE_FILE):
                shutil.copy(SAVE_FILE, SAVE_PREV)
            tmp = SAVE_FILE + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
            os.replace(tmp, SAVE_FILE)
        except OSError as e:
            input(f"❌ บันทึกไม่สำเร็จ: {e} (กด Enter)")
            return
        if not silent:
            input("💾 บันทึกเกมสำเร็จเรียบร้อย! (ความปลอดภัยไฟล์เซฟสูงสุด) (กด Enter)")

