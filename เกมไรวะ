    def gain_exp(self, amount):
        p = self.player
        if p["level"] >= MAX_LEVEL:
            return
        p["exp"] += int(amount)
        while p["level"] < MAX_LEVEL and p["exp"] >= exp_needed(p["level"]):
            p["exp"] -= exp_needed(p["level"])
            p["level"] += 1
            self.full_restore()
            print(f"
✨ {paint('LEVEL UP!', YELLOW)} ตอนนี้คุณเลเวล {p['level']} แล้ว (HP/MP/Stamina ฟื้นเต็ม)")
            print(f"🧬 ได้รับแต้มสเตตัส +{POINTS_PER_LEVEL} (ใช้ได้ที่เมนู 13)")
            for key, s in SKILLS.items():
                if s["lv"] == p["level"]:
                    print(f"📘 ปลดล็อกสกิลใหม่: {paint(s['name'], CYAN)} ({s['desc']})")
            self.check_titles()
        if p["level"] >= MAX_LEVEL:
            p["exp"] = 0

