    def player_damage(self, m, mult=1.0, ignore_def=False):
        raw = self.get_total_atk() * mult * random.uniform(0.9, 1.1)
        pen = self.rune_total("penetrate")
        mdef = max(0, m["def"] * (1 - pen / 100.0))
        red = 0 if ignore_def else mitigation(mdef, self.player["level"])
        dmg = raw * (1 - red)
        crit = random.randint(1, 100) <= self.crit_rate()
        if crit: dmg *= 1.7
        ls = self.rune_total("lifesteal")
        if "w2_vamp" in self.player["buffs"]:
            ls += 20
        if ls:
            self.player["hp"] = min(self.max_hp(), self.player["hp"] + int(dmg * ls / 100))
        return max(1, int(dmg)), crit

    def player_turn(self, m, log, can_flee):
        p = self.player
        print("1. ⚔️  โจมตีปกติ   2. ✨ สกิล   3. 🛡️ ป้องกัน   4. 🧪 ไอเทม   5. 🏃 หนี")
        choice = input("เลือก (1-5): ").strip()
        if choice == "1":
            dmg, crit = self.player_damage(m)
            m["hp"] -= dmg
            log.append(f"👉 โจมตีสร้างความเสียหาย {dmg}" + (" (CRITICAL!)" if crit else ""))
            return "used"
        if choice == "2":
            return self.use_skill(m, log)
        if choice == "3":
            self.guarding = True
            p["mp"] = min(self.max_mp(), p["mp"] + 15)
            log.append("🛡️ ตั้งท่าป้องกัน! ฟื้น MP +15")
            return "used"
        if choice == "4":
            keys = [k for k in CONSUMABLES if self.item_count(k) > 0 and not CONSUMABLES[k].get("out_only")]
            if not keys:
                print("ไม่มีไอเทมในกระเป๋า")
                return "invalid"
            for i, k in enumerate(keys):
                print(f"{i+1}. {CONSUMABLES[k]['name']}")
            idx = pick_index(input("เลือกไอเทม: ").strip(), len(keys))
            if idx is not None and self.use_consumable(keys[idx], in_combat=True):
                return "used"
            return "invalid"
        if choice == "5":
            if not can_flee:
                log.append("❌ หนีไม่ได้!")
                return "invalid"
            return "fled"
        return "invalid"

    def use_skill(self, m, log):
        p = self.player
        keys = [k for k, s in SKILLS.items() if p["level"] >= s["lv"]]
        for i, k in enumerate(keys):
            s = SKILLS[k]
            plus = self.ext["skill_plus"].get(k, 0)
            mp_cost = int(s["mp"] * (1 - plus * 0.05))
            print(f"{i + 1}. {s['name']} (+{plus}) - MP {mp_cost} - {s['desc']}")
        idx = pick_index(input("เลือกสกิล: ").strip(), len(keys))
        if idx is None:
            return "invalid"
        key = keys[idx]
        s = SKILLS[key]
        plus = self.ext["skill_plus"].get(key, 0)
        mp_cost = int(s["mp"] * (1 - plus * 0.05))
        mult_bonus = 1 + plus * 0.15
        if p["mp"] < mp_cost:
            log.append("❌ MP ไม่พอ!")
            return "invalid"
        p["mp"] -= mp_cost
        dmg, crit = self.player_damage(m, mult_bonus)
        if key in ("power", "vamp", "ultimate", "execute", "meteor", "judge", "blood_slashing", "god_slayer", "dark_eternity"):
            m["hp"] -= dmg
            log.append(f"✨ ใช้สกิล {s['name']} สร้างความเสียหาย {dmg}!")
        elif key == "heal":
            p["hp"] = min(self.max_hp(), p["hp"] + int(self.max_hp() * 0.4))
            log.append("💚 ฟื้นฟู HP 40%!")
        elif key == "guard" or key == "abyss_shield":
            self.shield = 3
            log.append("🛡️ สร้างข่ายเวทป้องกันดาเมจ!")
        return "used"

    def monster_turn(self, m, log):
        raw = m["atk"] * random.uniform(0.9, 1.15)
        red = mitigation(self.get_total_def(), m["level"])
        dmg = max(1, int(raw * (1 - red) * (0.4 if self.guarding else 1.0)))
        self.player["hp"] -= dmg
        log.append(f"💢 {m['name']} โจมตี → เสีย HP {dmg}")
        ref = self.rune_total("reflect")
        if ref > 0:
            ref_dmg = int(dmg * ref / 100.0)
            m["hp"] -= ref_dmg
            log.append(f"🔮 รูนสะท้อนความเสียหายใส่ {m['name']} {ref_dmg} ดาเมจ!")

    def combat(self, m, can_flee=True):
        log = []
        while m["hp"] > 0 and self.player["hp"] > 0:
            self.clear_screen()
            self.draw_combat(m)
            for line in log:
                print(line)
            log = []
            self.guarding = False
            res = self.player_turn(m, log, can_flee)
            if res == "invalid":
                continue
            if res == "fled":
                return "flee"
            if m["hp"] <= 0:
                break
            self.monster_turn(m, log)
        if self.player["hp"] <= 0:
            self.on_defeat(m)
            return "lose"
        self.on_victory(m)
        return "win"

    def on_defeat(self, m):
        d = DIFFICULTY[self.difficulty]
        lost = int(self.player["gold"] * d["death"])
        self.player["gold"] -= lost
        self.stats["deaths"] += 1
        self.full_restore()
        self.current_pos = [0, 0]
        print(paint(f"💀 คุณพ่ายแพ้ เสียทอง {lost} Gold...", RED))
        input("(กด Enter)")

