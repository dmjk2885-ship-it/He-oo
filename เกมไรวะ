            return {"name": "ไอเทมชำรุด", "type": "weapon", "atk": 1, "rarity": "Common", "tier": 1, "plus": 0}
        it.setdefault("rarity", "Common")
        it.setdefault("plus", 0)
        if it.get("type") in GEAR_SLOTS:
            it["tier"] = item_tier(it)
        return it

    def load_game(self):
        if not os.path.exists(SAVE_FILE):
            return
        if not os.path.exists(SAVE_BACKUP_V4):
            try:
                shutil.copy(SAVE_FILE, SAVE_BACKUP_V4)
            except OSError:
                pass
        try:
            with open(SAVE_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
        except Exception as e:
            print(f"⚠️  อ่านไฟล์เซฟไม่ได้ ({e}) เริ่มเกมใหม่")
            input("(กด Enter)")
            return
        try:
            self.apply_save(data)
        except Exception as e:
            print(f"⚠️  แปลงเซฟไม่สำเร็จ ({e}) เริ่มเกมใหม่")
            self.new_game()
            input("(กด Enter)")

    def apply_save(self, data):
        p = data.get("player")
        if not isinstance(p, dict):
            return
        player = self.player
        for k in list(player.keys()):
            if k in p and k not in ("equipment", "gear", "materials", "items", "buffs"):
                player[k] = p[k]
        for k in ("gear", "materials", "items", "buffs"):
            if isinstance(p.get(k), type(player[k])):
                player[k] = p[k]
        if isinstance(p.get("equipment"), dict):
            for slot in GEAR_SLOTS:
                if isinstance(p["equipment"].get(slot), dict):
                    player["equipment"][slot] = p["equipment"][slot]
        for slot in GEAR_SLOTS:
            if slot in player["equipment"]:
                player["equipment"][slot] = self.norm_item(player["equipment"][slot])
        player["gear"] = [self.norm_item(it) for it in player["gear"] if isinstance(it, dict) and it.get("type") in GEAR_SLOTS]

        player["level"] = max(1, min(MAX_LEVEL, int(player.get("level", 1))))
        player["exp"] = max(0, int(player.get("exp", 0)))
        player["gold"] = max(0, int(player.get("gold", 0)))

        self.visited_locations = {}
        for k, v in data.get("visited_locations", {}).items():
            self.visited_locations[k] = v if isinstance(v, dict) else {"type": "safe", "desc": str(v)}
        self.visited_locations.setdefault("0,0", {"type": "town", "desc": "เมืองหลวง", "zone": 0})
        pos = data.get("current_pos", [0, 0])
        self.current_pos = [int(pos[0]), int(pos[1])]
        self.dungeon_floor = max(1, min(100, int(data.get("dungeon_floor", 1))))
        self.dungeon_best = int(data.get("dungeon_best", 0))
        self.difficulty = data.get("difficulty", "ปกติ")
        self.world_event = data.get("world_event")
        for k in self.stats:
            if k in data.get("stats", {}):
                self.stats[k] = data["stats"][k]
        q = data.get("quests")
        if isinstance(q, dict):
            self.quests["active"] = q.get("active", [])
            self.quests["board"] = q.get("board", [])
            self.quests["story_step"] = q.get("story_step", 0)
            self.quests["story"] = q.get("story") or self.story_quest(self.quests["story_step"])
        self.load_ext(data)
        self.check_titles_silent()
        self.clamp_stats()

    def check_titles_silent(self):
        for name, desc, bonus, rule in TITLES:
            if rule and name not in self.player["titles"] and rule(self):
                self.player["titles"].append(name)

    TILE_SYMBOL = {
        "town": (YELLOW, "T"), "dungeon": (MAGENTA, "D"), "monster": (RED, "M"), "boss": (RED + BOLD, "B"),
        "resource": (CYAN, "R"), "event": (BLUE, "!"), "treasure": (YELLOW, "$"), "safe": (GREEN, "o"),
        "altar": (RED, "A"),
