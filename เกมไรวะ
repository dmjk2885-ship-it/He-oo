        parts = []
        if r.get("gold"): parts.append(f"{r['gold']} Gold")
        if r.get("exp"): parts.append(f"EXP {r['exp']}")
        for k, n in r.get("items", {}).items(): parts.append(f"{CONSUMABLES[k]['name']} x{n}")
        for k, n in r.get("materials", {}).items(): parts.append(f"{k} x{n}")
        for slot, tier, rar in r.get("gear", []): parts.append(f"{SLOT_TH[slot]}{TIERS[tier - 1]['name']} [{rar}]")
        for rid, rank in r.get("runes", []): parts.append(f"{RUNES[rid]['name']} {RANK_ROMAN[rank - 1]}")
        if r.get("title"): parts.append(f"ฉายา [{r['title']}]")
        return ", ".join(parts)

