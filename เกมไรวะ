    def build_monster(self, template, level, kind="normal", zone=0, boss_zone=None, dungeon=False):
        km = KIND_MULT[kind]
        d = DIFFICULTY[self.difficulty]
        hp = (25 + 14 * level + 0.6 * level ** 2) * MON_HP * template.get("hp", 1.0) * km["hp"] * d["hp"]
        atk = (7 + 2.6 * level) * MON_ATK * template.get("atk", 1.0) * km["atk"] * d["atk"]
        df = (2 + 1.5 * level) * template.get("def", 1.0) * km["def"]
        abilities = list(template.get("ab", []))
        name = template["name"]
        if kind == "elite":
            abilities.append(random.choice(ELITE_POOL))
            name = "💀 " + name + " ผู้นำฝูง"
        exp = (12 + 6 * level + 0.3 * level ** 2) * km["exp"] * d["reward"]
        gold = (8 + 3.5 * level) * km["gold"] * d["reward"]
        return {
            "name": name, "level": level, "hp": int(hp), "max_hp": int(hp), "atk": int(atk), "def": int(df),
            "ab": abilities, "kind": kind, "zone": zone, "tier": min(tier_of_level(level), len(TIERS)), "boss_zone": boss_zone,
            "dungeon": dungeon, "exp": int(exp), "gold": int(gold), "status": {}, "def_up": 0, "enraged": False, "stolen": 0,
        }

