    def quest_event(self, kind, monster=None):
        for q in self.all_quests():
            if q["type"] != kind:
                continue
            if kind == "kill" and monster:
                k = q["key"]
                ok = (k == "any" or (k == "elite" and monster["kind"] == "elite")
                      or (k == "boss" and monster["kind"] == "boss")
                      or k == f"zone:{monster['zone']}"
                      or (k.startswith("boss:") and monster.get("boss_zone") == int(k.split(":")[1])))
                if not ok:
                    continue
            q["progress"] = q.get("progress", 0) + 1

