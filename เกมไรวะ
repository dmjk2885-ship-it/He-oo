    def fast_travel(self):
        self.clear_screen()
        print("🌀 " + BOLD + "[ วาร์ปไปเมืองที่เคยค้นพบ ]" + RESET)
        towns = []
        for k, v in self.visited_locations.items():
            if v.get("type") == "town":
                x, y = (int(n) for n in k.split(","))
                dist = abs(x - self.current_pos[0]) + abs(y - self.current_pos[1])
                if dist > 0:
                    towns.append((k, x, y, dist))
        towns.sort(key=lambda t: t[3])
        if not towns:
            input("ยังไม่มีเมืองอื่นให้วาร์ป (กด Enter)")
            return
        for i, (k, x, y, dist) in enumerate(towns):
            zname = ZONES[min(self.tile_zone(k, self.visited_locations[k]), len(ZONES)-1)]["name"]
            print(f"{i + 1:2d}. พิกัด ({x},{y}) {zname}  - ค่าวาร์ป {10 + dist * 3} Gold")
        idx = pick_index(input("
เลือกเมือง (Enter เพื่อกลับ): ").strip(), len(towns))
        if idx is None:
            return
        k, x, y, dist = towns[idx]
        cost = 10 + dist * 3
        if self.player["gold"] < cost:
            input("❌ ทองไม่พอ (กด Enter)")
            return
        self.player["gold"] -= cost
        self.current_pos = [x, y]
        print("🌀 วาร์ปสำเร็จ!")
        time.sleep(0.8)
        self.town_menu(self.visited_locations[k])

