    def story_quest(self, step):
        if step >= len(STORY):
            return None
        return json.loads(json.dumps(STORY[step], ensure_ascii=False))

    def quest_value(self, q):
        t = q["type"]
        if t == "deliver":
            return min(q["need"], self.mat_count(q["key"]))
        if t == "floor":
            return min(q["need"], self.dungeon_best)
        if t == "zone":
            return min(q["need"], self.stats["max_zone"])
        return min(q["need"], q.get("progress", 0))

    def all_quests(self):
        qs = list(self.quests["active"])
        if self.quests.get("story"):
            qs.append(self.quests["story"])
