def exp_needed(level):
    return int(60 + 40 * level + 5 * level * level)

def calc_base_atk(level):
    return 8 + 3 * (level - 1)

def calc_base_def(level):
    return 3 + (level - 1)

def calc_max_hp(level):
    return 100 + 30 * (level - 1)

def calc_max_mp(level):
    return 30 + 6 * (level - 1)

def calc_max_stamina(level):
    return 60 + 10 * (level - 1)

def mitigation(defense, attacker_level):
    return min(0.75, max(0.0, defense) / (max(0.0, defense) + 40 + 6 * attacker_level))

def tier_of_level(level):
    t = 1
    for i, tr in enumerate(TIERS):
        if level >= tr["lv"]:
            t = i + 1
    return t

def zone_of_dist(dist):
    z = 0
    for i, zn in enumerate(ZONES):
        if dist >= zn["dist"]:
            z = i
    return z

def dungeon_level(floor):
    return 1 + int(floor * 0.55)

def make_gear(slot, tier, rarity="Common"):
    t = TIERS[min(tier - 1, len(TIERS) - 1)]
    mult = RARITY_MULT[rarity]
    item = {"name": f"{SLOT_TH[slot]}{t['name']}", "type": slot, "rarity": rarity, "tier": tier, "plus": 0}
    if slot == "weapon":
        item["atk"] = int(t["atk"] * mult)
    elif slot == "accessory":
        item["atk"] = int(t["atk"] * 0.6 * mult)
        item["def"] = int(t["def"] * 0.6 * mult)
        item["hp"] = int(t["lv"] * 15 * mult)
    else:
        item["def"] = int(t["def"] * SLOT_MULT[slot] * mult)
    return item

def item_tier(item):
    if item.get("tier"):
        return max(1, min(len(TIERS), int(item["tier"])))
    if item.get("type") == "weapon":
        stat, key = item.get("atk", 0), "atk"
    else:
        stat, key = item.get("def", 0) / SLOT_MULT.get(item.get("type"), 1.0), "def"
    t = 1
    for i, tr in enumerate(TIERS):
        if stat >= tr[key]:
            t = i + 1
    return t

def gear_price(item):
    if item.get("type") == "weapon":
        base = item.get("atk", 0) * 10
    elif item.get("type") == "accessory":
        base = (item.get("atk", 0) + item.get("def", 0)) * 12
    else:
        base = item.get("def", 0) * 14
    base += item.get("hp", 0) * 2 + item.get("crit", 0) * 40
    return int(base * (1 + 0.3 * item.get("plus", 0)))

RECIPE_BASE = {
    "weapon": (5, 3, 60), "armor": (6, 4, 60), "head": (3, 2, 40), "pants": (4, 3, 40), "boots": (3, 2, 30), "accessory": (5, 5, 80)
}

def recipe(slot, tier):
    ore, part, g = RECIPE_BASE[slot]
    return {"ore": ore + tier // 2, "part": part, "gold": int(g * tier ** 1.8)}

def enhance_info(item):
    p = item.get("plus", 0)
    tier = item_tier(item)
    chance = [1.0, 1.0, 1.0, 0.8, 0.8, 0.6, 0.6, 0.4, 0.4, 0.3][min(p, 9)]
    return {"ore": 2 + p, "core": 1 if p >= 5 else 0, "gold": int(40 * tier ** 1.6 * (p + 1)), "chance": chance}

