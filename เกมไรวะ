    def init_ext(self):
        self.ext = default_ext()
        self.world = 1
        self.worlds = {1: None, 2: None}
        self.scouted = {}

    def world_data(self):
        cur = {"visited": self.visited_locations, "pos": self.current_pos, "scouted": self.scouted}
        if self.world == 1:
            return cur, self.worlds.get(2)
        return self.worlds.get(1), cur

    def ext_for_save(self, w1, w2):
        e = json.loads(json.dumps(self.ext, ensure_ascii=False))
        e["world"] = self.world
        e["w1_scouted"] = w1["scouted"] if w1 else {}
        e["w2"] = w2
        return e

    def load_ext(self, data):
        self.init_ext()
        e = data.get("ext")
        if not isinstance(e, dict):
            return
        ext = self.ext
        if isinstance(e.get("stat_alloc"), dict):
            for k in ext["stat_alloc"]:
                ext["stat_alloc"][k] = int(e["stat_alloc"].get(k, 0))
        if isinstance(e.get("skill_plus"), dict):
            ext["skill_plus"] = {k: int(v) for k, v in e["skill_plus"].items()}
        for key in ("runes_bag", "runes_eq"):
            if isinstance(e.get(key), list):
                ext[key] = [r for r in e[key] if isinstance(r, dict) and r.get("id") in RUNES]
        w2 = e.get("w2")
        if isinstance(w2, dict) and isinstance(w2.get("visited"), dict):
            self.worlds[2] = w2
            if e.get("world") == 2:
                self.switch_world(2)

    def switch_world(self, n):
        if n == self.world:
            return
        self.worlds[self.world] = {"visited": self.visited_locations, "pos": self.current_pos, "scouted": self.scouted}
        tgt = self.worlds.get(n)
        if not tgt:
            tgt = {"visited": {"0,0": {"type": "town", "desc": "เมืองชายแดนโลกมืด", "zone": 7}}, "pos": [0, 0], "scouted": {}}
        self.worlds[n] = None
        self.visited_locations, self.current_pos, self.scouted = tgt["visited"], tgt["pos"], tgt["scouted"]
        self.world = n

    def gear_power(self, it):
        if not it:
            return 0
        base = self.gear_stat(it, "atk") if it.get("type") == "weapon" else self.gear_stat(it, "def")
        return base + it.get("hp", 0) * 0.15 + it.get("crit", 0) * 3

    def sorted_gear(self, mode="power"):
        gear = self.player["gear"]
        return sorted(gear, key=lambda it: -self.gear_power(it))

    def auto_equip(self):
        eq, gear, msgs = self.player["equipment"], self.player["gear"], []
        for slot in GEAR_SLOTS:
            cur = eq.get(slot)
            best, bp = None, self.gear_power(cur)
            for it in gear:
                if it.get("type") == slot:
                    gp = self.gear_power(it)
                    if gp > bp:
                        best, bp = it, gp
            if best is not None:
                gear.remove(best)
                if cur and cur.get("name") not in STARTER_NAMES:
                    gear.append(cur)
                eq[slot] = best
                msgs.append(f"⚡ สวมใส่อัตโนมัติ: {SLOT_TH[slot]} → {self.gear_str(best)}")
        if msgs:
            self.clamp_stats()
        return msgs

    def set_bonus(self):
        counts = {}
        for slot in GEAR_SLOTS:
            it = self.player["equipment"].get(slot)
            if it:
                t = item_tier(it)
                if t >= 2: counts[t] = counts.get(t, 0) + 1
        res = {"hp": 0, "atk": 0, "def": 0, "crit": 0, "pct": 0, "tier": 0, "count": 0}
        if not counts: return res
        tier, c = max(counts.items(), key=lambda kv: (kv[1], kv[0]))
        if c < 2: return res
        res["tier"], res["count"] = tier, c
        res["hp"] = 20 * tier
        if c >= 3: res["atk"] = 5 * tier
        if c >= 4: res["def"] = 4 * tier; res["crit"] = 3
        if c >= 5: res["pct"] = 10
        return res

    def set_text(self):
        sb = self.set_bonus()
        if not sb["count"]: return ""
        return f"ชุด{TIERS[min(sb['tier'] - 1, len(TIERS)-1)]['name']} {sb['count']}/5"

