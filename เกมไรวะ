    def add_material(self, name, n=1):
        self.player["materials"][name] = self.player["materials"].get(name, 0) + n

    def mat_count(self, name):
        return self.player["materials"].get(name, 0)

    def spend_material(self, name, n):
        left = self.mat_count(name) - n
        if left > 0:
            self.player["materials"][name] = left
        else:
            self.player["materials"].pop(name, None)

    def add_item(self, key, n=1):
        self.player["items"][key] = self.player["items"].get(key, 0) + n

    def item_count(self, key):
        return self.player["items"].get(key, 0)

    def cure_status(self):
        for k in list(self.player_status):
            del self.player_status[k]

    def use_consumable(self, key, in_combat=False):
        c = CONSUMABLES[key]
        p = self.player
        if self.item_count(key) <= 0:
            print("❌ ไม่มีไอเทมนี้")
            return False
        if in_combat and c.get("out_only"):
            print("❌ ใช้ไอเทมนี้ได้เฉพาะนอกการต่อสู้")
            return False
        if "hp" in c:
            if p["hp"] >= self.max_hp() and not c.get("cure"):
                print("❤️  HP เต็มอยู่แล้ว")
                return False
            heal = max(70, int(self.max_hp() * c["hp"]))
            p["hp"] = min(self.max_hp(), p["hp"] + heal)
            print(f"🧪 ใช้ {c['name']} ฟื้น HP +{heal}")
        if "mp" in c:
            if p["mp"] >= self.max_mp():
                print("🔷 MP เต็มอยู่แล้ว")
                return False
            gain = int(self.max_mp() * c["mp"])
            p["mp"] = min(self.max_mp(), p["mp"] + gain)
            print(f"🔷 ใช้ {c['name']} ฟื้น MP +{gain}")
        if "sta" in c:
            if p["stamina"] >= self.max_stamina():
                print("⚡ Stamina เต็มอยู่แล้ว")
                return False
            gain = int(self.max_stamina() * c["sta"])
            p["stamina"] = min(self.max_stamina(), p["stamina"] + gain)
            print(f"⚡ ใช้ {c['name']} ฟื้น Stamina +{gain}")
        if c.get("cure"):
            if "hp" not in c and not self.player_status:
                print("✨ ไม่มีสถานะผิดปกติให้ล้าง")
                return False
            self.cure_status()
            print("✨ ล้างสถานะผิดปกติแล้ว")
        if "buff" in c:
            name, turns = c["buff"]
            p["buffs"][name] = max(p["buffs"].get(name, 0), turns)
            print(f"🔔 เปิดใช้งาน {BUFF_LABEL.get(name, name)} จาก {c['name']}")
        self.spend_item_stock(key)
        return True

    def spend_item_stock(self, key):
        left = self.item_count(key) - 1
        if left > 0:
            self.player["items"][key] = left
        else:
            self.player["items"].pop(key, None)

