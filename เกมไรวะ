def paint(text, color):
    return f"{color}{text}{RESET}"

def bar(cur, mx, width=18, color=GREEN):
    mx = max(1, mx)
    fill = int(width * max(0, min(cur, mx)) / mx)
    return color + "█" * fill + GRAY + "░" * (width - fill) + RESET

def pick_index(raw, size):
    try:
        i = int(raw) - 1
    except (ValueError, TypeError):
        return None
    return i if 0 <= i < size else None

