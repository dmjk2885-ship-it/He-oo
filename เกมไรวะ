    def check_stamina(self, cost):
        if self.player["stamina"] < cost:
            print("⚠️  Stamina ไม่พอ! พักโรงแรม หรือใช้น้ำยาพลังงาน")
            input("(กด Enter)")
            return False
        self.player["stamina"] -= cost
        return True

    def tile_zone(self, key, tile):
        if "zone" in tile:
            return tile["zone"]
        x, y = key.split(",")
        return zone_of_dist(abs(int(x)) + abs(int(y)))

    def generate_tile(self, dist):
        z = zone_of_dist(dist)
        r = random.random()
        if self.world == 2 and r < 0.12:
            return {"type": "altar", "desc": "แท่นบูชาเลือดแห่งโลกมืด", "zone": z}
        if r < 0.08:
            t, d = "town", "หมู่บ้านการค้าชายแดน"
        elif r < 0.15:
            t, d = "dungeon", "ปากทางเข้าดันเจี้ยนโบราณ"
        elif r < 0.20 and dist >= 3:
            t, d = "boss", "รังของหัวหน้าโซน"
        elif r < 0.50:
            t, d = "monster", "เขตซุ่มซ่อนของมอนสเตอร์"
        elif r < 0.68:
            t, d = "resource", "จุดทรัพยากร (แหล่งแร่)"
        elif r < 0.80:
            t, d = "event", "สถานที่ลึกลับ"
        elif r < 0.85:
            t, d = "treasure", "หีบสมบัติโบราณ"
        else:
            t, d = "safe", "จุดพักผ่อนโล่งแจ้ง"
        return {"type": t, "desc": d, "zone": z}

    def map_exploration_menu(self):
        moves = {"1": (1, 0), "d": (1, 0), "2": (0, 1), "w": (0, 1), "3": (0, -1), "s": (0, -1), "4": (-1, 0), "a": (-1, 0)}
        while True:
            self.clear_screen()
            self.draw_ui()
            self.draw_minimap()
            z = min(self.zone_index(), len(ZONES) - 1)
            zn = ZONES[z]
            my_lv = self.player["level"]
            warn = ""
            if my_lv < zn["lv"][0] - 2:
                warn = paint("  ⚠️ อันตราย! เลเวลต่ำกว่าที่แนะนำ", RED)
            print(f"📌 โซนปัจจุบัน: {paint(zn['name'], YELLOW)} (แนะนำ LV {zn['lv'][0]}-{zn['lv'][1]}){warn}")
            print(f"เลือกทิศทางเดิน [-{self.step_cost()} Stamina]:")
            print("1. ➡️  ไปทางขวา (X+1)   [D]")
            print("2. ⬆️  เดินขึ้น (Y+1)    [W]")
            print("3. ⬇️  เดินลง (Y-1)     [S]")
            print("4. ⬅️  ถอยหลัง (X-1)    [A]")
            print("5. 🌀 วาร์ปไปเมืองที่เคยค้นพบ")
            print("6. 🔙 กลับสู่เมนูหลัก")

            choice = input("
เลือกคำสั่ง: ").strip().lower()
            if choice == "6":
                break
            if choice == "5":
                self.fast_travel()
                continue
            if choice not in moves:
                input("❌ เลือกไม่ถูกต้อง (กด Enter)")
                continue
            if not self.check_stamina(self.step_cost()):
                continue
            dx, dy = moves[choice]
            self.current_pos[0] += dx
            self.current_pos[1] += dy
            self.stats["steps"] += 1
            self.stats["max_zone"] = max(self.stats["max_zone"], self.zone_index())
            self.tick_world_event()

            key = f"{self.current_pos[0]},{self.current_pos[1]}"
            if key not in self.visited_locations:
                self.visited_locations[key] = self.scouted.pop(key, None) or self.generate_tile(self.distance())
                self.stats["explored"] += 1
                self.quest_event("explore")
            tile = self.visited_locations[key]
            print(f"
🚶 เดินทางถึงพิกัด X:{self.current_pos[0]}, Y:{self.current_pos[1]} ({tile['desc']})...")
            time.sleep(0.8)
            self.handle_tile(key, tile)
            self.check_titles()
            if self.player["hp"] <= 0:
                break

    def tick_world_event(self):
        if self.world_event:
            self.world_event["steps"] -= 1
            if self.world_event["steps"] <= 0:
                print(f"
{WORLD_EVENTS[self.world_event['key']]['name']} สิ้นสุดลงแล้ว")
                self.world_event = None
        elif random.random() < 0.04:
            key = random.choice(list(WORLD_EVENTS))
            we = WORLD_EVENTS[key]
            self.world_event = {"key": key, "steps": we["steps"]}
            print(f"
🌍 {paint('อีเวนต์โลก: ' + we['name'], YELLOW)}")
            print(f"   {we['desc']} (นาน {we['steps']} ก้าว)")
            time.sleep(1.5)

    def handle_tile(self, key, tile):
        t = tile.get("type", "safe")
        if t == "town":
            self.town_menu(tile)
        elif t == "dungeon":
            print("✨ คุณพบทางเข้าดันเจี้ยนลับ!")
            if input("ต้องการเข้าสู่ดันเจี้ยนไหม? (y/n): ").strip().lower() == "y":
                self.dungeon_menu()
        elif t == "monster":
            self.encounter_field_monster(tile)
        elif t == "boss":
            self.boss_lair(key, tile)
        elif t == "resource":
            self.gather_resource(key, tile)
        elif t == "treasure":
            self.open_treasure(key, tile)
        elif t == "altar":
            self.blood_altar_event()
        elif t == "event":
            tile["type"] = "safe"
            tile["desc"] = "จุดที่เคยเกิดเหตุการณ์"
            self.random_event(key, tile)
        else:
            self.safe_spot()

