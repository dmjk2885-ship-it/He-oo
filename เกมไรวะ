    def short_gear(self, it):
        if not it:
            return "ไม่มี"
        plus = f"+{it['plus']}" if it.get("plus") else ""
        if it.get("type") == "weapon":
            stat = f"ATK {self.gear_stat(it, 'atk')}"
        elif it.get("type") == "accessory":
            stat = f"ATK {self.gear_stat(it, 'atk')} DEF {self.gear_stat(it, 'def')}"
        else:
            stat = f"DEF {self.gear_stat(it, 'def')}"
        extra = ""
        if it.get("hp"):
            extra += f" HP+{it['hp']}"
        if it.get("crit"):
            extra += f" CRIT+{it['crit']}%"
        return f"{it['name']}{plus} {paint('[' + stat + extra + ']', CYAN)}"

    def gear_str(self, it):
        if not it:
            return "ไม่มี"
        plus = f" +{it['plus']}" if it.get("plus") else ""
        if it.get("type") == "weapon":
            stat = f"ATK {self.gear_stat(it, 'atk')}"
        elif it.get("type") == "accessory":
            stat = f"ATK {self.gear_stat(it, 'atk')} DEF {self.gear_stat(it, 'def')}"
        else:
            stat = f"DEF {self.gear_stat(it, 'def')}"
        extra = ""
        if it.get("hp"):
            extra += f" HP+{it['hp']}"
        if it.get("crit"):
            extra += f" CRIT+{it['crit']}%"
        return f"{rarity_tag(it.get('rarity', 'Common'))} {it['name']}{plus} [{stat}{extra}]"

